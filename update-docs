        md = html_to_md(content, WB_BASE)
        if state.changed(f"wb/news/{news_id}", md):
            (changelog_dir / f"{news_id}.md").write_text(md, encoding="utf-8")
            updated += 1

    if updated:
        print(f"  [WB] UPDATED: {updated} news items")
    else:
        print("  [WB] unchanged: news")


