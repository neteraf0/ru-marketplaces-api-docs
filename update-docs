async def fetch_wb(page: Page, state: State):
    print("[WB] Starting...")
    out_dir = ROOT / "wb"

    # WB uses __wbaas antibot that requires stealth + real Chrome
    await page.goto(f"{WB_BASE}/en", wait_until="domcontentloaded")
    try:
        await page.wait_for_function(
            "() => document.title.includes('WB API')",
            timeout=30000,
        )
    except Exception:
        print("  [WB] WARN: antibot may not have cleared")
    await page.wait_for_timeout(2000)

    # Extract antibot cookies — subsequent RSC fetches use HTTP (much faster than 12 browser navigations)
    wb_cookies = await page.context.cookies([WB_BASE])
    print(
        f"  [WB] antibot passed, extracted {len(wb_cookies)} cookies"
        f" — fetching {len(WB_SECTIONS)} sections via HTTP"
    )

    rsc_headers = {
        "RSC": "1",
        "Accept": "text/x-component",
        "Referer": f"{WB_BASE}/en",
        "Next-Router-Prefetch": "1",
    }

    for section in WB_SECTIONS:
        url = f"{WB_BASE}/en/docs/openapi/{section}"
        print(f"  [WB] {section}...", end=" ", flush=True)

        state_obj = None

        # Try HTTP first (avoids full browser navigation per section)
        rsc_text = _http_get_text(url, wb_cookies, rsc_headers)
        if rsc_text:
            state_obj = _parse_wb_rsc(rsc_text)

        # Fallback: browser JS fetch (inherits browser cookies)
        if state_obj is None:
            rsc_text = await browser_fetch_text(page, url, {"RSC": "1"})
            if rsc_text:
                state_obj = _parse_wb_rsc(rsc_text)

        if state_obj is None:
            print("WARN: no redoc_state")
            continue

        spec = state_obj.get("spec", {}).get("data", {})
        if not spec:
            print("WARN: empty spec")
            continue

        section_dir = out_dir / section
        n = save_openapi_split(section_dir, section, spec, state)
        print("UPDATED" if n else "unchanged")

    await _fetch_wb_release_notes(page, out_dir, state)
    await _fetch_wb_news(page, out_dir, state)


