def _bundle_openapi(main_file: Path) -> dict[str, Any]:
    """Load a split OpenAPI spec, resolving all file-based $ref references inline."""
    import yaml as _yaml  # pyyaml

    _cache: dict[
        str, Any
    ] = {}  # keyed by str(resolved_path) — Path hashing unreliable in Py3.14

    def _load(path: Path) -> Any:
        key = str(path.resolve())
        if key in _cache:
            return _cache[key]
        raw = path.read_text(encoding="utf-8")
        data = (
            _yaml.safe_load(raw)
            if path.suffix in (".yaml", ".yml")
            else json.loads(raw)
        )
        _cache[key] = data  # store before resolving refs — breaks reference cycles
        return data

    def _resolve(obj: Any, base_dir: Path, depth: int = 0) -> Any:
        if depth > 60:  # guard against pathological nesting
            return obj
        if isinstance(obj, dict):
            if (
                "$ref" in obj
                and isinstance(obj["$ref"], str)
                and not obj["$ref"].startswith("#")
            ):
                ref_path = (base_dir / obj["$ref"]).resolve()
                ref_data = _load(ref_path)
                return _resolve(ref_data, ref_path.parent, depth + 1)
            return {k: _resolve(v, base_dir, depth + 1) for k, v in obj.items()}
        if isinstance(obj, list):
            return [_resolve(item, base_dir, depth + 1) for item in obj]
        return obj

    root = _load(main_file)
    result = _resolve(root, main_file.parent)
    return result if isinstance(result, dict) else {}


def _git_clone_or_pull(repo_url: str, repo_dir: Path, label: str) -> bool:
    """Clone or pull a git repo. Returns True on success."""
    import subprocess

    if repo_dir.exists():
        print(f"  [{label}] git pull...")
        r = subprocess.run(
            ["git", "pull", "--ff-only"], cwd=repo_dir, capture_output=True, text=True
        )
        print(f"  [{label}] {r.stdout.strip() or r.stderr.strip()}")
        return r.returncode == 0
    else:
        print(f"  [{label}] git clone (first run, may take a minute)...")
        r = subprocess.run(
            ["git", "clone", "--depth=1", repo_url, str(repo_dir)],
            capture_output=True,
            text=True,
        )
        if r.returncode != 0:
            print(f"  [{label}] ERROR: {r.stderr}")
            return False
        print(f"  [{label}] cloned to {repo_dir}")
        return True


async def fetch_ym(state: State):
    """
    Official Yandex Market OpenAPI specs live in the GitHub repo:
    https://github.com/yandex-market/yandex-market-partner-api (official Yandex org)

    We clone it and convert all OpenAPI YAML/JSON files to split per-tag MDs.
    The SPA docs site (yandex.ru/dev/market/...) only renders 13 pages and
    misses most content, so the GitHub source is more complete.
    """
    print("[YM] Starting...")

    out_dir = ROOT / "ymarket"
    out_dir.mkdir(parents=True, exist_ok=True)

    if not _git_clone_or_pull(YM_REPO, YM_REPO_DIR, "YM"):
        print("  [YM] ERROR: cannot clone repo, skipping")
        return

    updated = 0

    # Copy markdown docs as-is
    for md_file in YM_REPO_DIR.rglob("*.md"):
        rel = md_file.relative_to(YM_REPO_DIR)
        if any(p.startswith(".") or p == "node_modules" for p in rel.parts):
            continue
        content = md_file.read_text(encoding="utf-8", errors="replace")
        if state.changed(f"ym/md/{rel}", content):
            dest = out_dir / rel
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_text(content, encoding="utf-8")
            updated += 1

    # Bundle and convert OpenAPI specs (resolving $ref: file.yaml references)
    main_spec = YM_REPO_DIR / "openapi" / "openapi.yaml"
    if main_spec.exists():
        print("  [YM] bundling OpenAPI spec (resolving file $refs)...")
        try:
            bundled = _bundle_openapi(main_spec)
            n = save_openapi_split(out_dir, "openapi", bundled, state)
            updated += n
            if n:
                print(f"  [YM] UPDATED: {n} tag files")
            else:
                print("  [YM] unchanged: openapi")
        except Exception as e:
            print(f"  [YM] ERROR bundling openapi.yaml: {e}")
    else:
        print("  [YM] WARN: openapi/openapi.yaml not found in repo")

    if updated:
        print(f"  [YM] total updated: {updated} files")
    else:
        print("  [YM] unchanged")


