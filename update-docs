def _resolve_ref(ref: str, components: dict) -> dict:
    # Support #/components/schemas/Name and #/definitions/Name
    parts = ref.lstrip("#/").split("/")
    node = (
        {"components": components}
        if parts[0] == "components"
        else {"definitions": components.get("definitions", {})}
    )
    for p in parts:
        if isinstance(node, dict):
            node = node.get(p, {})
    return node if isinstance(node, dict) else {}


def _schema_to_example(schema: dict, components: dict, depth: int = 0) -> object:
    """Synthesize an example value from a schema using field-level example annotations.

    Used when the spec has no top-level response example (e.g. Yandex Market).
    Returns None if nothing meaningful can be built.
    """
    if depth > 8 or not schema:
        return None

    if "$ref" in schema:
        return _schema_to_example(
            _resolve_ref(schema["$ref"], components), components, depth + 1
        )

    if "example" in schema:
        return schema["example"]

    if schema.get("allOf"):
        result: dict = {}
        for sub in schema["allOf"]:
            sub_ex = _schema_to_example(sub, components, depth + 1)
            if isinstance(sub_ex, dict):
                result.update(sub_ex)
        return result or None

    for combiner in ("oneOf", "anyOf"):
        if schema.get(combiner):
            return _schema_to_example(schema[combiner][0], components, depth + 1)

    stype = schema.get("type", "")

    if stype == "array" or "items" in schema:
        item_ex = _schema_to_example(schema.get("items", {}), components, depth + 1)
        return [item_ex] if item_ex is not None else []

    if stype == "object" or schema.get("properties"):
        result = {}
        for fname, fschema in schema.get("properties", {}).items():
            val = _schema_to_example(fschema, components, depth + 1)
            if val is not None:
                result[fname] = val
        return result or {}

    if stype == "boolean":
        return False
    if stype == "integer":
        return schema.get("minimum", 0)
    if stype in ("number", "float", "double"):
        return schema.get("minimum", 0.0)
    if stype == "string":
        if schema.get("enum"):
            return schema["enum"][0]
        fmt = schema.get("format", "")
        if fmt in ("date-time", "datetime"):
            return "2024-01-01T00:00:00Z"
        if fmt == "date":
            return "2024-01-01"
        return "string"

    return None


def _schema_md(schema: dict, components: dict, depth: int = 0) -> str:
    if depth > 5 or not schema:
        return ""
    indent = "  " * depth

    if "$ref" in schema:
        resolved = _resolve_ref(schema["$ref"], components)
        return _schema_md(resolved, components, depth)

    stype = schema.get("type", "")
    lines = []

    if stype == "array":
        items = schema.get("items", {})
        lines.append(f"{indent}*Array of:*")
        lines.append(_schema_md(items, components, depth + 1))

    elif schema.get("properties") or stype == "object":
        required = set(schema.get("required", []))
        lines.append(f"\n{indent}| Field | Type | Req | Description |")
        lines.append(f"{indent}|-------|------|-----|-------------|")
        for name, fschema in schema.get("properties", {}).items():
            if "$ref" in fschema:
                resolved = _resolve_ref(fschema["$ref"], components)
                ftype = fschema["$ref"].split("/")[-1]
                desc = resolved.get("description", "")
            else:
                ftype = fschema.get("type", "")
                if fschema.get("enum"):
                    ftype += (
                        " (enum: " + ", ".join(str(e) for e in fschema["enum"]) + ")"
                    )
                desc = fschema.get("description", "")
            ex = fschema.get("example", "")
            if ex:
                desc += f" *Example: `{ex}`*"
            req = "✓" if name in required else ""
            desc = desc.replace("\n", " ").replace("|", "\\|")
            lines.append(f"{indent}| `{name}` | {ftype} | {req} | {desc} |")

    elif stype in ("string", "integer", "number", "boolean"):
        parts = [f"`{stype}`"]
        if schema.get("enum"):
            parts.append("enum: " + ", ".join(f"`{e}`" for e in schema["enum"]))
        if schema.get("example") is not None:
            parts.append(f"example: `{schema['example']}`")
        if schema.get("description"):
            parts.append(schema["description"])
        lines.append(f"{indent}" + " — ".join(parts))

    return "\n".join(lines)


def _write_example(
    example_dir: Path,
    key: str,
    data,
    shared_dir: Path | None = None,
    shared_map: dict | None = None,
) -> str:
    """Write example data to a JSON file; return relative path for MD links.

    If shared_dir + shared_map are provided, identical content is written once
    to shared_dir and subsequent callers receive a link to that shared file,
    eliminating duplicate JSON blobs (e.g. identical 423 error responses).
    The returned path is relative to the *MD file* in tag_dir/ (not example_dir/).
    """
    blob = json.dumps(data, indent=2, ensure_ascii=False)

    if shared_dir is not None and shared_map is not None:
        h = hashlib.md5(blob.encode()).hexdigest()
        if h in shared_map:
            return shared_map[h]
        shared_dir.mkdir(parents=True, exist_ok=True)
        slug = re.sub(r"[^\w]", "_", key)[:80].strip("_")
        fname = f"{slug}.json"
        # Avoid collisions (different content, same derived slug — rare but possible)
        counter = 0
        while (shared_dir / fname).exists():
            counter += 1
            fname = f"{slug}_{counter}.json"
        (shared_dir / fname).write_text(blob, encoding="utf-8")
        # Path is relative from tag_dir/{op}.md → ../_shared/examples/{fname}
        rel = f"../_shared/examples/{fname}"
        shared_map[h] = rel
        return rel

    # Per-tag examples/ directory (default)
    slug = re.sub(r"[^\w]", "_", key)[:120].strip("_")
    fname = f"{slug}.json"
    example_dir.mkdir(parents=True, exist_ok=True)
    (example_dir / fname).write_text(blob, encoding="utf-8")
    return f"examples/{fname}"


def _emit_example(
    lines: list,
    example_dir: Path | None,
    key: str,
    label: str,
    data,
    shared_dir: Path | None = None,
    shared_map: dict | None = None,
) -> None:
    """Append example to lines — inline JSON or external file link depending on example_dir."""
    if example_dir is not None:
        rel = _write_example(example_dir, key, data, shared_dir, shared_map)
        lines.append(f"\n[{label}]({rel})\n")
    else:
        lines.append(
            f"\n```json\n{json.dumps(data, indent=2, ensure_ascii=False)}\n```\n"
        )


def openapi_to_md(
    spec: dict, example_dir: Path | None = None, title_prefix: str = ""
) -> str:
    """Convert an OpenAPI spec to Markdown.

    example_dir: if set, examples are written as JSON files there and linked from the MD.
    """
    info = spec.get("info", {})
    components = spec.get("components", spec.get("definitions", {}))
    if "definitions" in spec and "components" not in spec:
        components = {
            "schemas": spec.get("definitions", {}),
            "definitions": spec.get("definitions", {}),
        }

    heading = (
        f"{title_prefix}{info.get('title', 'API')}"
        if title_prefix
        else info.get("title", "API")
    )
    lines = [
        f"# {heading}",
        f"\nVersion: **{info.get('version', '')}**",
    ]
    if info.get("description"):
        lines.append(f"\n{info['description']}")

    servers = spec.get("servers", [])
    if not servers and spec.get("host"):
        proto = spec.get("schemes", ["https"])[0]
        servers = [{"url": f"{proto}://{spec['host']}{spec.get('basePath', '')}"}]
    if servers:
        lines.append("\n## Servers\n")
        for s in servers:
            lines.append(
                f"- `{s['url']}`"
                + (f" — {s.get('description', '')}" if s.get("description") else "")
            )

    # Group operations by tag
    paths = spec.get("paths", {})
    tags: dict[str, list] = {}
    for path, path_item in paths.items():
        path_servers = path_item.get("servers", servers)
        for method, op in path_item.items():
            if method not in (
                "get",
                "post",
                "put",
                "patch",
                "delete",
                "head",
                "options",
            ):
                continue
            for tag in op.get("tags", ["Other"]):
                tags.setdefault(tag, []).append(
                    (method.upper(), path, op, path_servers)
                )

    for tag, ops in tags.items():
        lines.append(f"\n---\n## {tag}")
        for method, path, op, path_servers in ops:
            op_key = _op_slug(method, path)
            lines.append(f"\n### `{method}` {path}\n")

            if path_servers and path_servers != servers:
                lines.append(f"**Server:** `{path_servers[0]['url']}`\n")

            if op.get("summary"):
                lines.append(f"**{op['summary']}**\n")
            if op.get("description"):
                lines.append(op["description"] + "\n")

            if op.get("deprecated"):
                lines.append("> ⚠️ **Deprecated**\n")

            # Parameters
            params = op.get("parameters", [])
            if params:
                lines.append("**Parameters:**\n")
                lines.append("| Name | In | Type | Req | Description |")
                lines.append("|------|----|------|-----|-------------|")
                for p in params:
                    if "$ref" in p:
                        p = _resolve_ref(p["$ref"], components) or p
                    name = p.get("name", "")
                    if not name:
                        continue
                    sch = p.get("schema", {})
                    if "$ref" in sch:
                        sch = _resolve_ref(sch["$ref"], components)
                    ptype = sch.get("type", p.get("type", ""))
                    if sch.get("enum"):
                        ptype += (
                            " (enum: " + ", ".join(str(e) for e in sch["enum"]) + ")"
                        )
                    desc = (
                        p.get("description", "").replace("\n", " ").replace("|", "\\|")
                    )
                    ex = sch.get("example", p.get("example", ""))
                    if ex:
                        desc += f" *Example: `{ex}`*"
                    req = "✓" if p.get("required") else ""
                    lines.append(
                        f"| `{name}` | {p.get('in', '')} | {ptype} | {req} | {desc} |"
                    )
                lines.append("")

            # Request body
            rb = op.get("requestBody") or op.get("body")
            if rb:
                lines.append("**Request Body:**\n")
                content = rb.get("content", {})
                if not content and rb.get("schema"):
                    content = {"application/json": {"schema": rb["schema"]}}
                for media_type, media in content.items():
                    lines.append(f"Content-Type: `{media_type}`\n")
                    if sch := media.get("schema"):
                        lines.append(_schema_md(sch, components))
                    if ex := media.get("example"):
                        _emit_example(
                            lines, example_dir, f"{op_key}_req", "Request example", ex
                        )
                    for ex_name, ex_obj in media.get("examples", {}).items():
                        if "$ref" in ex_obj:
                            ex_obj = _resolve_ref(ex_obj["$ref"], components)
                        val = ex_obj.get("value", ex_obj)
                        _emit_example(
                            lines,
                            example_dir,
                            f"{op_key}_req_{ex_name}",
                            f"Request: {ex_name}",
                            val,
                        )

            # Responses
            responses = op.get("responses", {})
            if responses:
                lines.append("**Responses:**\n")
                for code, resp in responses.items():
                    desc = resp.get("description", "")
                    lines.append(f"#### `{code}` {desc}\n")
                    for media_type, media in resp.get("content", {}).items():
                        sch = media.get("schema")
                        if sch:
                            lines.append(_schema_md(sch, components))
                        if ex := media.get("example"):
                            _emit_example(
                                lines,
                                example_dir,
                                f"{op_key}_{code}",
                                f"Response {code}",
                                ex,
                            )
                        elif (
                            not media.get("examples")
                            and sch
                            and example_dir is not None
                        ):
                            gen = _schema_to_example(sch, components)
                            if gen is not None:
                                _emit_example(
                                    lines,
                                    example_dir,
                                    f"{op_key}_{code}",
                                    f"Response {code}",
                                    gen,
                                )
                        for ex_name, ex_obj in media.get("examples", {}).items():
                            if "$ref" in ex_obj:
                                ex_obj = _resolve_ref(ex_obj["$ref"], components)
                            val = ex_obj.get("value", ex_obj)
                            _emit_example(
                                lines,
                                example_dir,
                                f"{op_key}_{code}_{ex_name}",
                                f"Response {code}: {ex_name}",
                                val,
                            )

    return "\n".join(lines)


