def save_spec(
    out_dir: Path, name: str, spec: dict, state: State, example_dir: Path | None = None
) -> bool:
    """Save OpenAPI spec as .json + single .md. Returns True if updated."""
    json_str = json.dumps(spec, ensure_ascii=False, indent=2)
    if not state.changed(f"{out_dir.name}/{name}", json_str):
        return False

    out_dir.mkdir(parents=True, exist_ok=True)
    (out_dir / f"{name}.json").write_text(json_str, encoding="utf-8")
    if example_dir:
        example_dir.mkdir(parents=True, exist_ok=True)
    md = openapi_to_md(spec, example_dir=example_dir)
    (out_dir / f"{name}.md").write_text(md, encoding="utf-8")
    return True


def _op_slug(method: str, path: str) -> str:
    return re.sub(r"[^\w]", "_", f"{method}_{path}").strip("_")[:80]


_HTML_TAG_RE = re.compile(r"<[^>]+>")


def _strip_html(text: str) -> str:
    return _HTML_TAG_RE.sub("", text).strip()


_HTTP_STATUS_NAMES = {
    "200": "OK",
