def _validate_ozon_spec(path: Path) -> tuple[bool, str]:
    """Return (ok, message). Rejects empty/partial specs to protect the cache."""
    try:
        spec = json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        return False, f"invalid JSON: {exc}"

    if not isinstance(spec, dict):
        return False, "file is not a JSON object"

    paths = spec.get("paths", {})
    if not paths:
        return False, "no 'paths' section — probably wrong file"

    n_paths = len(paths)
    if n_paths < 50:
        return False, (
            f"too few endpoints: {n_paths} "
            f"(expected ~430 — possibly incomplete download)"
        )

    tags: set[str] = set()
    for path_item in paths.values():
        if not isinstance(path_item, dict):
            continue
        for method, op in path_item.items():
            if method in ("get", "post", "put", "patch", "delete") and isinstance(op, dict):
                tags.update(op.get("tags", []))

    n_tags = len(tags)
    if n_tags < 5:
        return False, f"too few tags: {n_tags} (expected ~52)"

    return True, f"{n_paths} endpoints, {n_tags} tags"


def _term_link(url: str, text: str) -> str:
    """OSC 8 terminal hyperlink — clickable in iTerm2, modern terminals."""
    return f"\033]8;;{url}\033\\{text}\033]8;;\033\\"


def _find_in_downloads() -> Path | None:
    """Return the most-recently-modified seller.json / swagger.json in ~/Downloads, if any."""
    downloads = Path.home() / "Downloads"
    if not downloads.exists():
        return None
    candidates = []
    for name in ("seller.json", "swagger.json"):
        p = downloads / name
        if p.exists():
            candidates.append(p)
    if not candidates:
        return None
    return max(candidates, key=lambda p: p.stat().st_mtime)


def _ask_ozon_json() -> Path | None:
    """Prompt for seller.json path, validate it. Returns Path or None (skip)."""
    cached = ROOT / "ozon" / "seller.json"
    hint = " (Enter = use cache)" if cached.exists() else " (Enter = skip)"

    swagger_link = _term_link(OZON_SPEC_URL, OZON_SPEC_URL)
    print("  [Ozon] Open in browser → Save As… seller.json")
    print(f"         {swagger_link}")

    # Auto-detect a freshly downloaded file
    dl = _find_in_downloads()
    if dl:
        ok, msg = _validate_ozon_spec(dl)
        if ok:
            answer = input(f"  [Ozon] Found {dl.name} in Downloads — use it? [Y/n]: ").strip().lower()
            if answer not in ("n", "no"):
                print(f"  [Ozon] ✓ {msg}")
                return dl

    while True:
        raw = input(f"  [Ozon] Path to seller.json{hint}: ").strip()

        if not raw:
            if cached.exists():
                ok, msg = _validate_ozon_spec(cached)
                if ok:
                    print(f"  [Ozon] cache: {msg}")
                    return cached
                print(f"  [Ozon] cache is invalid ({msg}), provide file manually")
                continue
            return None

        path = Path(raw).expanduser()
        if not path.exists():
            print(f"  [Ozon] file not found: {path}")
            continue

        ok, msg = _validate_ozon_spec(path)
        if ok:
            print(f"  [Ozon] ✓ {msg}")
            return path

        print(f"  [Ozon] ✗ {msg}")
        if input("  Try another file? [Y/n]: ").strip().lower() in ("n", "no"):
            return None


