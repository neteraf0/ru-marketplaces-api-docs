async def _fetch_wb_news(page: Page, out_dir: Path, state: State):
    """Fetch WB news/digest pages."""
    url = f"{WB_BASE}/en/news"
    await page.goto(url, wait_until="networkidle")

    # Find all news links
    links = await page.evaluate("""() => {
        return [...document.querySelectorAll('a[href*="/news/"]')]
            .map(a => a.href)
            .filter(h => { try { return /[/]news[/]\\d+$/.test(h); } catch(e) { return false; } });
